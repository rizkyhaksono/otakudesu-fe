# Backend API. Server-side only — never exposed to the browser, which is why it
# has no NEXT_PUBLIC_ prefix.
API_BASE_URL=http://localhost:3000

# Public origin of this site, used for canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://otakudesu.natee.my.id

# Movies & series (TMDB). Off on the public deployment; set to true when
# self-hosting. Build-time: changing it needs a rebuild.
NEXT_PUBLIC_ENABLE_MOVIE=false
